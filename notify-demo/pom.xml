<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gabrielbbaldez</groupId>
        <artifactId>notify-hub-parent</artifactId>
        <version>0.8.0</version>
    </parent>

    <artifactId>notify-demo</artifactId>
    <name>NotifyHub Demo</name>
    <description>Demo Spring Boot app showcasing all NotifyHub features. Run it and hit the endpoints!</description>

    <dependencies>
        <!-- NotifyHub starter — the whole point -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web for REST endpoints -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- SMS via Twilio -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-sms</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Slack channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-slack</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Telegram channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-telegram</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Discord channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-discord</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- WebSocket channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-websocket</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Google Chat channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-google-chat</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Teams channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-teams</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Firebase Push channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-push-firebase</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Generic Webhook channel -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-webhook</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Admin Dashboard -->
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-admin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Thymeleaf (needed for admin dashboard) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- GreenMail embedded — no external SMTP needed to demo -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- Swagger / OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.5.0</version>
        </dependency>
    </dependencies>

    <!-- Demo app — do not publish to Maven Central -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
