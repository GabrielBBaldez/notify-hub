<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gabrielbbaldez</groupId>
        <artifactId>notify-hub-parent</artifactId>
        <version>0.9.0</version>
    </parent>

    <artifactId>notify-spring-boot-starter</artifactId>
    <name>NotifyHub Spring Boot Starter</name>
    <description>Spring Boot auto-configuration for NotifyHub. Add this dependency and configure via application.yml.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-email</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-sms</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-slack</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-telegram</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-discord</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-teams</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-push-firebase</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-webhook</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-websocket</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-google-chat</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-twitter</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-linkedin</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-notion</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-twitch</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>notify-youtube</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Micrometer -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- OpenTelemetry / Tracing (optional — user adds to enable) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- GreenMail for real SMTP testing -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>2.0.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
